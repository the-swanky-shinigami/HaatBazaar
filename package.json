{
  "name": "haatbazaar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "pages:functions": "wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 execute haatbazaar-db --local --file=./db/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute haatbazaar-db --local --file=./db/0002_seed_data.sql",
    "db:migrate:remote": "wrangler d1 execute haatbazaar-db --remote --file=./db/0001_initial_schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.6",
    "wrangler": "^3.78.6"
  }
}
